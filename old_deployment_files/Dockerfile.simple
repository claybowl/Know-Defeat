FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the application
COPY . .

# Use CJS format
RUN sed -i 's/serverModuleFormat: .esm./serverModuleFormat: "cjs"/' vite.config.js

# Set environment variables
ENV NODE_ENV=production
ENV PORT=8080
ENV USE_MOCK_DATA=true

# Build the app
RUN npm run build

# Create explicit healthcheck endpoint
RUN echo "const express = require('express'); \
const app = express(); \
app.get('/health', (req, res) => res.send('OK')); \
app.get('/healthcheck', (req, res) => res.send('OK')); \
app.listen(8081, () => console.log('Health server running on port 8081'));" > health.js

# Start the server
EXPOSE 8080
EXPOSE 8081

# Start both servers
CMD npm start & node health.js